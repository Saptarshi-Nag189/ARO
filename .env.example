# ==============================================================================
# ARO — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Get free OpenRouter API keys at: https://openrouter.ai/keys
# ==============================================================================

# ─── API Keys (at minimum, set OPENROUTER_API_KEY) ────────────────────────────

# Default key — used for Trinity Large Preview (research, innovation, orchestrator)
# Also used as fallback for any model without a dedicated key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Separate key for Step 3.5 Flash (planner, claim extraction)
# If blank, falls back to OPENROUTER_API_KEY
OPENROUTER_API_KEY_STEP=

# Optional: Separate key for GPT-OSS-120B (skeptic, synthesis, reflection)
# If blank, falls back to OPENROUTER_API_KEY
OPENROUTER_API_KEY_GPT_OSS=

# ─── Server Security ─────────────────────────────────────────────────────────

# Optional: API key to protect /api/ endpoints
# Leave empty to disable auth (development only)
ARO_API_KEY=

# ─── Server Configuration ────────────────────────────────────────────────────

# ARO_HOST=127.0.0.1
# ARO_PORT=5000
# ARO_MAX_CONCURRENT=3

# ─── LangGraph Engine (v3) ───────────────────────────────────────────────────

# Durable checkpointing backend. Default: SQLite file next to the app.
# Point at Postgres (e.g. AWS RDS) for production durability:
# ARO_CHECKPOINT_URI=postgresql://user:pass@host:5432/aro
# ARO_CHECKPOINT_SQLITE=aro_checkpoints.db

# Model provider: openrouter (default) or bedrock (requires langchain-aws
# + AWS credentials). The Bedrock path is the pluggable AWS integration.
# ARO_MODEL_PROVIDER=openrouter
# ARO_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-east-1

# Offline deterministic mode — no API keys, no network. Used by CI/tests.
# ARO_FAKE_MODEL=1

# ─── LangSmith Observability (optional but recommended) ──────────────────────
# Free tier: https://smith.langchain.com — traces every agent call,
# powers the eval suite and the CI eval gate.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=aro-v3
